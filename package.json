{
  "name": "crossval-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-Rate Pricing Calculator backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
