    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "neverthrow": "8.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.2.3",
    "supertest": "7.0.0",
    "ts-jest": "29.2.6",
    "tsx": "4.16.2",
    "typescript": "5.5.4"
